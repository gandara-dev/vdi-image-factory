{
  "name": "VDI Image Factory",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Image Builder", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": {
    "image-builder": "pwsh -NoProfile -File scripts/Start-ImageBuilder.ps1 -Port 8765"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "extensions": ["ms-vscode.powershell", "hashicorp.hcl"]
    }
  }
}
