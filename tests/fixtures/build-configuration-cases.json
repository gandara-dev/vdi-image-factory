{
  "description": "Shared validation cases. Each case patches config/build.example.json and lists the exact error paths both the PowerShell module and the Image Builder page must report.",
  "cases": [
    { "name": "example is valid", "patch": {}, "errors": [] },
    { "name": "image without MCS is valid", "patch": { "mcs": null }, "errors": [] },
    { "name": "Static allocation with pt-BR and a Brazilian time zone", "patch": { "image.regional.locale": "pt-BR", "image.regional.timeZone": "E. South America Standard Time", "mcs.allocationType": "Static" }, "errors": [] },
    { "name": "ISO checksum accepted when present", "patch": { "image.isoUrl": "file:///C:/ISO/Win11.iso", "image.isoChecksum": "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" }, "errors": [] },
    { "name": "select every catalog application", "patch": { "image.applications.include": ["*"] }, "errors": [] },
    { "name": "unsupported schema version", "patch": { "schemaVersion": 2 }, "errors": ["schemaVersion"] },
    { "name": "image name with spaces", "patch": { "image.name": "my image" }, "errors": ["image.name"] },
    { "name": "empty image version", "patch": { "image.version": "" }, "errors": ["image.version"] },
    { "name": "edition index out of range", "patch": { "image.windowsImageIndex": 0 }, "errors": ["image.windowsImageIndex"] },
    { "name": "malformed checksum", "patch": { "image.isoChecksum": "md5:abc" }, "errors": ["image.isoChecksum"] },
    { "name": "one vCPU", "patch": { "image.hardware.cpus": 1 }, "errors": ["image.hardware.cpus"] },
    { "name": "fractional vCPU", "patch": { "image.hardware.cpus": 2.5 }, "errors": ["image.hardware.cpus"] },
    { "name": "memory below Windows 11 minimum", "patch": { "image.hardware.memoryMb": 2048 }, "errors": ["image.hardware.memoryMb"] },
    { "name": "memory not a multiple of 1024", "patch": { "image.hardware.memoryMb": 8000 }, "errors": ["image.hardware.memoryMb"] },
    { "name": "disk below 64 GB", "patch": { "image.hardware.diskSizeMb": 32768 }, "errors": ["image.hardware.diskSizeMb"] },
    { "name": "blank switch", "patch": { "image.hardware.switchName": "  " }, "errors": ["image.hardware.switchName"] },
    { "name": "unknown locale and time zone", "patch": { "image.regional.locale": "xx-XX", "image.regional.timeZone": "Mars Standard Time" }, "errors": ["image.regional.locale", "image.regional.timeZone"] },
    { "name": "no profile", "patch": { "image.applications.profiles": [] }, "errors": ["image.applications.profiles"] },
    { "name": "unknown profile", "patch": { "image.applications.profiles": ["standard", "gaming"] }, "errors": ["image.applications.profiles[1]"] },
    { "name": "unknown include and exclude IDs", "patch": { "image.applications.include": ["Example.Missing"], "image.applications.exclude": ["7zip.7zip", "Example.Other"] }, "errors": ["image.applications.include[0]", "image.applications.exclude[1]"] },
    { "name": "optimizer flag must be boolean", "patch": { "image.optimizer.enabled": "yes" }, "errors": ["image.optimizer.enabled"] },
    { "name": "catalog name with forbidden characters", "patch": { "mcs.catalogName": "Engineering: Desktops" }, "errors": ["mcs.catalogName"] },
    { "name": "catalog name with edge spaces", "patch": { "mcs.catalogName": " Engineering" }, "errors": ["mcs.catalogName"] },
    { "name": "naming scheme without #", "patch": { "mcs.namingScheme": "VDI-ENG-" }, "errors": ["mcs.namingScheme"] },
    { "name": "naming scheme with two # runs", "patch": { "mcs.namingScheme": "VDI-##-##" }, "errors": ["mcs.namingScheme"] },
    { "name": "naming scheme starting with a hyphen", "patch": { "mcs.namingScheme": "-VDI-###" }, "errors": ["mcs.namingScheme"] },
    { "name": "naming scheme longer than 15 characters", "patch": { "mcs.namingScheme": "ENGINEERING-W11-###" }, "errors": ["mcs.namingScheme"] },
    { "name": "naming scheme without letters", "patch": { "mcs.namingScheme": "123-###" }, "errors": ["mcs.namingScheme"] },
    { "name": "domain that is not an FQDN", "patch": { "mcs.domain": "CORP" }, "errors": ["mcs.domain"] },
    { "name": "OU that is not a distinguished name", "patch": { "mcs.organizationalUnit": "VDI/Engineering" }, "errors": ["mcs.organizationalUnit"] },
    { "name": "OU outside the domain", "patch": { "mcs.organizationalUnit": "OU=VDI,DC=other,DC=example,DC=test" }, "errors": ["mcs.organizationalUnit"] },
    { "name": "more machines than the naming scheme allows", "patch": { "mcs.namingScheme": "VDI-ENG-##", "mcs.machineCount": 100 }, "errors": ["mcs.machineCount"] },
    { "name": "zero machines", "patch": { "mcs.machineCount": 0 }, "errors": ["mcs.machineCount"] },
    { "name": "unknown allocation type", "patch": { "mcs.allocationType": "Pooled" }, "errors": ["mcs.allocationType"] },
    { "name": "catalog machine memory below minimum", "patch": { "mcs.machine.memoryMb": 1024 }, "errors": ["mcs.machine.memoryMb"] },
    { "name": "missing hardware section", "patch": { "image.hardware": null }, "errors": ["image.hardware"] }
  ]
}
